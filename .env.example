# Copy this file to .env in the project root before running docker-compose.
# NEVER commit the real .env file.

POSTGRES_DB=keystone
POSTGRES_USER=keystone
POSTGRES_PASSWORD=change-me-locally

# Generate a real secret for anything beyond local dev, e.g.: openssl rand -base64 48
JWT_SECRET=change-this-secret-in-production-must-be-at-least-256-bits-long
JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api

SLA_LOW_HOURS=72
SLA_MEDIUM_HOURS=48
SLA_HIGH_HOURS=24
SLA_URGENT_HOURS=4
